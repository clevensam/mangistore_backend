# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# SQLite Database URL - local dev file. On Render, point this at the persistent
# disk, e.g. file:/data/mangistore.db (filesystem is ephemeral otherwise).
DATABASE_URL="file:./dev.db"

# JWT Secret for token signing (change in production!)
JWT_SECRET="your-super-secret-key-change-in-production"

# Frontend URL for CORS
FRONTEND_URL=https://your-frontend.vercel.app

# Server Port
PORT=3000

# Email (SMTP) for OTP verification
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
