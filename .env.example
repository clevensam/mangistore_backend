# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Supabase Postgres - transaction pooler (Prisma uses transactions)
# Format: postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# JWT Secret for token signing (change in production!)
JWT_SECRET="your-super-secret-key-change-in-production"

# Frontend URL for CORS
FRONTEND_URL=https://your-frontend.vercel.app

# Server Port
PORT=3000

# Email (SMTP) for OTP verification
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
